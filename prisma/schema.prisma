generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  password      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  profile       PlayerProfile?
  matches       Match[]
  aiAnalyses    AIAnalysis[]
  ratingHistory RatingHistory[]
  apiUsage      ApiUsage[]
}

model PlayerProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  age            Int?
  battingStyle   String?
  bowlingStyle   String?
  teamName       String?
  bio            String?
  avatar         String?
  onboardingDone Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id        String   @id @default(cuid())
  userId    String
  opponent  String
  date      DateTime
  format    String
  venue     String?
  result    String
  notes     String?
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  batting  BattingPerf?
  bowling  BowlingPerf?
  fielding FieldingPerf?
  balls    BallEvent[]
}

model BattingPerf {
  id            String @id @default(cuid())
  matchId       String @unique
  runs          Int    @default(0)
  balls         Int    @default(0)
  fours         Int    @default(0)
  sixes         Int    @default(0)
  dismissalType String @default("Did Not Bat")
  position      Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model BowlingPerf {
  id           String @id @default(cuid())
  matchId      String @unique
  overs        Float  @default(0)
  runsConceded Int    @default(0)
  wickets      Int    @default(0)
  maidens      Int    @default(0)
  wides        Int    @default(0)
  noBalls      Int    @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model FieldingPerf {
  id        String @id @default(cuid())
  matchId   String @unique
  catches   Int    @default(0)
  runOuts   Int    @default(0)
  stumpings Int    @default(0)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model AIAnalysis {
  id            String   @id @default(cuid())
  userId        String
  createdAt     DateTime @default(now())
  strengths     String[]
  weaknesses    String[]
  improvements  String[]
  trainingPlan  String   @db.Text
  matchStrategy String   @db.Text
  rating        Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RatingHistory {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  rating    Float
  breakdown Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiUsage {
  id         String   @id @default(cuid())
  userId     String
  weekNumber Int
  year       Int
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber, year])
}

model BallEvent {
  id              String  @id @default(cuid())
  matchId         String
  over            Int
  ball            Int
  runs            Int     @default(0)
  extras          Int     @default(0)
  wicket          Boolean @default(false)
  wicketType      String?
  battingPlayerId String?
  bowlingPlayerId String?
  shotRegion      String?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
